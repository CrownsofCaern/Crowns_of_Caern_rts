     "xp": 800
    },
    {
     "win": true
    }
   ]
  },
  "stone": {
   "title": "The Stone in the Roots",
   "kind": "side",
   "steps": [
    {
     "text": "Take the stone circle between the Covenant camps",
     "done": {
      "cleared": "root_stone"
     }
    }
   ],
   "reward": [
    {
     "xp": 300
    }
   ]
  },
  "aelith": {
   "title": "The Last Grove",
   "kind": "side",
   "steps": [
    {
     "text": "Answer the druid Aelith Moss",
     "done": {
      "flag": "aelith_decided"
     }
    }
   ],
   "reward": [
    {
     "xp": 150
    }
   ]
  }
 },
 "dialogues": {
  "aelith": {
   "nodes": {
    "start": {
     "text": "Stop, Regent. I am Aelith Moss. I don't speak for Cerrid. I speak for the grove he is trying to save.",
     "next": "b"
    },
    "b": {
     "text": "Your rot follows your dead, and your dead are walking north. There is one grove left in the Elderwold, Heartwood. If the rot reaches its roots, we lose more than trees.",
     "next": "c"
    },
    "c": {
     "text": "Swear the rot stays out of Heartwood, and my people will stop carrying Cerrid's torches. He will have to burn your graves himself.",
     "choices": [
      {
       "text": "I swear it. The rot stays out of Heartwood.",
       "do": [
        {
         "flag": "aelith_decided"
        },
        {
         "flag": "rot_pact"
        }
       ],
       "next": "pact"
      },
      {
       "text": "The rot goes where the dead go. I can't promise you a forest.",
       "do": [
        {
         "flag": "aelith_decided"
        }
       ],
       "next": "no"
      }
     ]
    },
    "pact": {
     "text": "Then my people go home. Cerrid's own band will still fight you. That's between the two of you."
    },
    "no": {
     "text": "Honest. Then the torches stay lit."
    }
   }
  },
  "aelith_after": {
   "nodes": {
    "start": {
     "text": "The roots remember everything, Regent. Even promises made by the dead."
    }
   }
  },
  "gall": {
   "nodes": {
    "start": {
     "text": "Regent. The Charnel House is full of druid dead from the burnings. Good stock. Wiry. What shall I make of them?",
     "choices": [
      {
       "text": "Crawlers. Send them to the front.",
       "do": [
        {
         "flag": "gall_decided"
        },
        {
         "spawn": "charnel_gift"
        }
       ],
       "next": "crawl"
      },
      {
       "text": "Bone and sinew for the dwellings.",
       "do": [
        {
         "flag": "gall_decided"
        },
        {
         "res": {
          "wood": 200,
          "ore": 150
         }
        }
       ],
       "next": "bone"
      }
     ]
    },
    "crawl": {
     "text": "Three of them, Regent. They still smell of smoke."
    },
    "bone": {
     "text": "Bone and sinew. Nothing wasted, Regent. Nothing ever wasted."
    }
   }
  },
  "gall_after": {
   "nodes": {
    "start": {
     "text": "The pits are busy, Regent. Busier every day."
    }
   }
  },
  "cerrid_parley": {
   "nodes": {
    "start": {
     "who": "cerrid",
     "text": "Rot-queen. Everything your dead walk on dies. The grass, the roots, the water. Do you even see it?",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "I see a druid burning graves. Those were people, Cerrid.",
     "next": "c"
    },
    "c": {
     "who": "cerrid",
     "text": "Those were people. Now they're kindling. Torches!"
    }
   }
  }
 },
