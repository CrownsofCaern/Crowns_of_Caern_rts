 "quests": {
  "main": {
   "title": "Rot in the Roots",
   "kind": "main",
   "steps": [
    {
     "text": "Take the Covenant camps at Briarwatch and Elderfall",
     "done": {
      "all": [
       {
        "held": "briarwatch"
       },
       {
        "held": "elderfall"
       }
      ]
     },
     "do": [
