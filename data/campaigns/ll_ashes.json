 "dialogues": {
  "sabine": {
   "nodes": {
    "start": {
     "text": "Wren of Greyhold. Sabine Ost, Margravine of the Iron Reserve. We last rode a hundred years ago. My great-grandmother rode beside your Orrin.",
     "next": "b"
    },
    "b": {
     "text": "The capital sends us to stand on the river. I would rather put two of my knights where they'd do some good. Tell me where.",
     "choices": [
      {
       "text": "With me. We go for the war-leaders.",
       "do": [
        {
         "flag": "sabine_decided"
        },
        {
         "flag": "margraves_ride"
        },
        {
         "spawn": "margraves"
        },
        {
         "join": "margraves"
        }
       ],
       "next": "ride"
      },
      {
       "text": "Hold the river. If we fail, you're all that's left.",
       "do": [
        {
         "flag": "sabine_decided"
        },
        {
         "flag": "margraves_hold"
        },
        {
         "item": {
          "rarity": "rare",
          "slot": "armor",
          "level": 12
         }
        }
       ],
       "next": "hold"
      }
     ]
    },
    "ride": {
     "text": "Then the Margraves ride again. Try to keep up, Wren."
    },
    "hold": {
     "text": "Sensible. Your Orrin would have said the same. Take my mail, then. It was made for a bigger fool than either of us."
    }
   }
  },
  "sabine_after": {
   "nodes": {
    "start": {
     "text": "Iron holds."
    }
   }
  },
  "vessa": {
   "nodes": {
    "start": {
     "text": "Don't. I'm not one of theirs. Not any more. I was a Concord hedge-witch before the ash came up and swallowed my village. Now I'm whatever this is.",
     "next": "b"
    },
    "b": {
     "text": "Sesk keeps wards around her: two of my sisters and their hounds. I can break them from here. Let me walk away when it's done, Concord, and Sesk stands naked.",
     "choices": [
      {
       "text": "Break the wards, and walk away.",
       "do": [
        {
         "flag": "vessa_decided"
        },
        {
         "flag": "witch_bargain"
        },
        {
         "remove": "sesk_wards"
        },
        {
         "leave": "vessa",
         "to": [
          0.02,
          0.98
         ]
        }
       ],
       "next": "deal"
      },
      {
       "text": "You're Host now. I'm sorry.",
       "do": [
        {
         "flag": "vessa_decided"
        },
        {
         "flag": "witch_slain"
        },
        {
         "hostile": "vessa"
        }
       ],
       "next": "fight"
      },
      {
       "text": "Edda, can she be helped?",
       "if": {
        "companion": "Sister Edda Vey"
       },
       "next": "edda"
      }
     ]
    },
    "edda": {
     "who": "edda",
     "text": "No, my lord. The ash is in her. But she can choose what she does with the time she has left. Let her.",
     "choices": [
      {
       "text": "Break the wards, and walk away.",
       "do": [
        {
         "flag": "vessa_decided"
        },
        {
         "flag": "witch_bargain"
        },
        {
         "remove": "sesk_wards"
        },
        {
         "leave": "vessa",
         "to": [
          0.02,
          0.98
         ]
        }
       ],
       "next": "deal"
      },
      {
       "text": "No. I can't trust anything from the Wound.",
       "do": [
        {
         "flag": "vessa_decided"
        },
        {
         "flag": "witch_slain"
        },
        {
         "hostile": "vessa"
        }
       ],
       "next": "fight"
      }
     ]
    },
    "deal": {
     "text": "It's done. You'll hear Sesk scream from here. Goodbye, Concord."
    },
    "fight": {
     "text": "Then I'll take one of you with me."
    }
   }
  },
  "vessa_after": {
   "nodes": {
    "start": {
     "text": "..."
    }
   }
  },
  "gorrath_parley": {
   "nodes": {
    "start": {
     "who": "gorrath",
     "text": "The gate's open, little knight. There is nothing on the other side of it you can kill. Come and die on this side, then."
    }
   }
  },
  "sesk_parley": {
   "nodes": {
    "start": {
     "who": "sesk",
     "text": "I smell lamp-oil. One of the lantern-priests walks with you. We ate a lantern-priest once. He told us everything about the stone."
    }
   }
  }
 },
