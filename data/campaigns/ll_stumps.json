 "dialogues": {
  "gil": {
   "nodes": {
    "start": {
     "text": "My lord. There's still standing timber east of the Felling Camp, if you want it. My crews could have it down in a week and in your palisades by the next.",
     "choices": [
      {
       "text": "Cut it. We need every plank.",
       "do": [
        {
         "flag": "gil_decided"
        },
        {
         "flag": "felled_more"
        },
        {
         "res": {
          "wood": 250,
          "gold": 150
         }
        }
       ],
       "next": "cut"
      },
      {
       "text": "Leave it standing. Enough has been cut here.",
       "do": [
        {
         "flag": "gil_decided"
        },
        {
         "flag": "left_standing"
        }
       ],
       "next": "leave"
      }
     ]
    },
    "cut": {
     "text": "Aye, my lord. The Covenant won't like it."
    },
    "leave": {
     "text": "...As you say, my lord. Strange orders for a forester, but I'll give them."
    }
   }
  },
  "gil_after": {
   "nodes": {
    "start": {
     "text": "The crews are ready if you need them."
    }
   }
  },
  "aelith": {
   "nodes": {
    "start": {
     "text": "You walk through the bones of my forest in iron shoes, Concord. You'll want to know why we hate you. Look around.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "I know what was done here. I need the road east. I'm not here for your trees.",
     "next": "c"
    },
    "c": {
     "text": "There is one grove left. Heartwood, between our towns. Its roots go down further than you can think. Swear you will not burn it, and my hunters will stay out of the tree line while you settle things with Neve.",
     "choices": [
      {
       "text": "I swear it. Heartwood stands.",
       "do": [
        {
         "flag": "aelith_decided"
        },
        {
         "flag": "heartwood_oath"
        }
       ],
       "next": "oath"
      },
      {
       "text": "I don't swear oaths in a war.",
       "do": [
        {
         "flag": "aelith_decided"
        }
       ],
       "next": "no"
      }
     ]
    },
    "oath": {
     "text": "Then the tree line is quiet, for as long as your oath holds. Neve's own band won't listen to me. That fight is yours."
    },
    "no": {
     "text": "Honest, at least. Then the tree line will be full of arrows."
    }
   }
  },
  "aelith_after": {
   "nodes": {
    "start": {
     "text": "The roots remember everything, Concord. Even you."
    }
   }
  },
  "neve_parley": {
   "nodes": {
    "start": {
     "who": "neve",
     "text": "Wren. You came the short way, through the stumps. Do you even know what grew here?",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Trees. A long time ago.",
     "next": "c"
    },
    "c": {
     "who": "neve",
     "text": "Trees. Yes. Only trees. Bows!"
    }
   }
  }
 },
