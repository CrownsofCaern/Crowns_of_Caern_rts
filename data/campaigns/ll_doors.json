 "dialogues": {
  "greave": {
   "nodes": {
    "start": {
     "who": "greave",
     "text": "A Concord knight at my door. They'll be cutting a new rune for that up at the gate: the day the debtors came back.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "The Lockstone is cracking, master Greave. My great-grandfather said so with his last breath.",
     "next": "c"
    },
    "c": {
     "who": "greave",
     "text": "Your great-grandfather was right, and the Forge has known for ten years. Ask at the gate if you like. They'll tell you what they told me when I said we should help: debts first.",
     "next": "d"
    },
    "d": {
     "who": "greave",
     "text": "And when you've asked, the wardens will come down here to clear the debtors off their road. Me included. Stand with me when they do, and I'll owe you.",
     "do": [
      {
       "flag": "greave_met"
      }
     ],
     "next": "e"
    },
    "e": {
     "who": "greave",
     "text": "One more thing. My apprentice, Nim, went up to the old mine for ore four days ago. Something lives up there now.",
     "choices": [
      {
       "text": "I'll look for Nim.",
       "do": [
        {
         "start_quest": "apprentice"
        }
       ]
      },
      {
       "text": "The gate first."
      }
     ]
    }
   }
  },
  "greave_idle": {
   "nodes": {
    "start": {
     "who": "greave",
     "text": "Mind the crossbows on the ledges. Wardens don't miss."
    }
   }
  },
  "nim_trapped": {
   "nodes": {
    "start": {
     "text": "Is someone there? Don't come in, there's things in the dark! Big ones!"
    }
   }
  },
  "nim": {
   "nodes": {
    "start": {
     "text": "You killed them? All of them? Master Greave said Concord folk were soft. He was wrong. Or you're not Concord.",
     "next": "b"
    },
    "b": {
     "text": "I've been hiding in the ore cart for four days. I'm not going back to sweeping his floor, my lord. Take me with you. I can shoot a rivet-bow.",
     "choices": [
      {
       "text": "Then shoot for us, Nim.",
       "do": [
        {
         "flag": "nim_decided"
        },
        {
         "flag": "nim_joined"
        },
        {
         "join": "nim"
        }
       ],
       "next": "join"
      },
      {
       "text": "Your master is sick with worry. Go home.",
       "do": [
        {
         "flag": "nim_decided"
        },
        {
         "flag": "nim_home"
        },
        {
         "leave": "nim",
         "to": "workshop"
        }
       ],
       "next": "home"
      }
     ]
    },
    "join": {
     "text": "Ha! Wait till he hears. Don't tell him I said that."
    },
    "home": {
     "text": "...Fine. He'll make me sweep for a month. Here, he'll want you to have something for it. He always does."
    }
   }
  },
  "hessa": {
   "nodes": {
    "start": {
     "text": "That's far enough, Concord. Say your piece from there.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "The Lockstone is failing. The dead walk in the south and a dead knight told me to come here. I'm asking the Forge for help.",
     "next": "c"
    },
    "c": {
     "text": "Asking. Forty years ago the Concord stopped asking and stopped paying. We kept the runes cut on our own silver until there was no more silver. You owe us forty years.",
     "choices": [
      {
       "text": "Take what I have, as a start. (150 marks)",
       "if": {
        "marks": 150
       },
       "do": [
        {
         "flag": "asked_gate"
        },
        {
         "flag": "paid_debt"
        },
        {
         "marks": -150
        },
        {
         "spawn": "workshop_raid"
        },
        {
         "attack": "workshop_raid",
         "to": "workshop"
        }
       ],
       "next": "paid"
      },
      {
       "text": "The Concord will pay once the stone holds.",
       "do": [
        {
         "flag": "asked_gate"
        },
        {
         "spawn": "workshop_raid"
        },
        {
         "attack": "workshop_raid",
         "to": "workshop"
        }
       ],
       "next": "promise"
      },
      {
       "text": "Then I'll talk to whoever holds your leash.",
       "do": [
        {
         "flag": "asked_gate"
        },
        {
         "spawn": "workshop_raid"
        },
        {
         "attack": "workshop_raid",
         "to": "workshop"
        }
       ],
       "next": "rude"
      }
     ]
    },
    "paid": {
     "text": "...A knight who pays from his own purse. That's new. It changes nothing at the gate, but take this; my rune, not the Forge's. Now go. The wardens are already marching.",
     "do": [
      {
       "item": {
        "rarity": "rare",
        "slot": "charm",
        "level": 6
       }
      }
     ]
    },
    "promise": {
     "text": "We've heard that one. The wardens are marching for Greave's workshop. Go and stand with your friend, debtor."
    },
    "rude": {
     "text": "Dask Vell holds the leash, and he's already loosed it. Listen. That's the wardens marching on Greave's workshop."
    }
   }
  },
  "hessa_after": {
   "nodes": {
    "start": {
     "text": "The gate stays shut, Concord."
    }
   }
  },
  "vell_parley": {
   "nodes": {
    "start": {
     "who": "vell",
     "text": "Wren. You broke my post and you killed my wardens on our own road. Debtors don't usually fight back.",
     "next": "b"
    },
    "b": {
     "who": "vell",
     "text": "Say what you came to say. I'll still drive you off, but I'll hear it.",
     "choices": [
      {
       "text": "What is wrong with the Lockstone, Vell?",
       "do": [
        {
         "flag": "learned_lockstone"
        }
       ],
       "next": "stone"
      },
      {
       "text": "Open the gate, or I open it.",
       "next": "end"
      }
     ]
    },
    "stone": {
     "who": "vell",
     "text": "Wrong? It's old. Runes wear. The Forge cut them fresh every ten years, on Concord silver, until the silver stopped. The last cutting was forty years ago. Do you understand? We told you. Every year, we told you.",
     "next": "end"
    },
    "end": {
     "who": "vell",
     "text": "Wardens! Shields up!"
    }
   }
  }
 },
