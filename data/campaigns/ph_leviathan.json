 "dialogues": {
  "sedge": {
   "nodes": {
    "start": {
     "text": "The dead queen, at my door. I've been waiting. You want the name of the thing in the mire. Every fool with a crown wants that name, sooner or later.",
     "next": "b"
    },
    "b": {
     "text": "I'll give it. Names cost, though. What will you give old Sedge?",
     "choices": [
      {
       "text": "Mossgate is under my hand. Its people bring you peat every winter, and they will go on doing it.",
       "if": {
        "flag": "living_protected"
       },
       "do": [
        {
         "flag": "sedge_decided"
        },
        {
         "flag": "has_name"
        }
       ],
       "next": "mossgate"
      },
      {
       "text": "A hundred marks of grave-silver.",
       "if": {
        "marks": 100
       },
       "do": [
        {
         "flag": "sedge_decided"
        },
        {
         "flag": "has_name"
        },
        {
         "marks": -100
        }
       ],
       "next": "paid"
      },
      {
       "text": "Your life, if you don't give it to me.",
       "do": [
        {
         "flag": "sedge_decided"
        },
        {
         "flag": "has_name"
        },
        {
         "flag": "sedge_cursed"
        }
       ],
       "next": "threat"
      }
     ]
    },
    "mossgate": {
     "text": "Ha! The Mossgate peat. I know it. Warm as a loaf. All right, dead queen. Lean close. Its name is Ruvh. Say it into the water, not to the air."
    },
    "paid": {
     "text": "Silver from graves. Good. Lean close. Its name is Ruvh. Say it into the water, not to the air."
    },
    "threat": {
     "text": "Threats, from a corpse. Fine. Ruvh. That's its name. And I hope it eats you first."
    }
   }
  },
  "sedge_after": {
   "nodes": {
    "start": {
     "text": "Into the water, dead queen. Not to the air."
    }
   }
  },
  "leviathan_asleep": {
   "nodes": {
    "start": {
     "who": "hero",
     "text": "Bones the size of a barn, and water running out of its eyes. Not yet. It needs a heart, a name and a bell."
    }
   }
  },
  "raise": {
   "nodes": {
    "start": {
     "who": "hero",
     "text": "Heart. Name. Bell. Ruvh. Ruvh, under the water. You drowned before anyone could hate you. Get up, and I'll give you something to hate.",
     "next": "b"
    },
    "b": {
     "text": "...",
     "do": [
      {
       "flag": "leviathan_raised"
      },
      {
       "join": "leviathan"
      }
     ],
     "next": "c"
    },
    "c": {
     "who": "hero",
     "text": "There. There it is. Now, Skarn."
    }
   }
  },
  "skarn_idle": {
   "nodes": {
    "start": {
     "text": "Come closer, corpse-queen."
    }
   }
  },
  "skarn_parley": {
   "nodes": {
    "start": {
     "who": "skarn",
     "text": "So you're the one burning my diggers. The queen of the leftovers. I expected something bigger.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Look up, Skarn.",
     "next": "c"
    },
    "c": {
     "who": "skarn",
     "text": "...Huh. That is bigger. Host! Hold the pit!"
    }
   }
  }
 },
