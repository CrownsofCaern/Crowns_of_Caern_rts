 "dialogues": {
  "miller_hiding": {
   "nodes": {
    "start": {
     "text": "Get down! They're still at the granary!"
    }
   }
  },
  "miller": {
   "nodes": {
    "start": {
     "text": "They only wanted the grain, my lord. They didn't touch anyone who didn't fight. That's the strange part. They looked thinner than us."
    }
   }
  },
  "reeve": {
   "nodes": {
    "start": {
     "who": "reeve",
     "text": "My lord! Coldwater's granary still stands, thanks to you. But there's more of them camped up at Grimfell. Women, children, old ones. A whole clan.",
     "next": "b"
    },
    "b": {
     "who": "reeve",
     "text": "Their chief wants to talk to whoever's in charge. I told her that was you. I hope that was right.",
     "do": [
      {
       "flag": "reeve_spoke"
      }
     ]
    }
   }
  },
  "reeve_idle": {
   "nodes": {
    "start": {
     "who": "reeve",
     "text": "We'll hold the granary. Somehow."
    }
   }
  },
  "ostler": {
   "nodes": {
    "start": {
     "text": "They wanted the horses for meat, my lord. Meat. Good Concord draught horses. Well, they've not got them now.",
     "next": "b"
    },
    "b": {
     "text": "Take these shoes. My father's best. A horse doesn't need them more than a knight does today.",
     "do": [
      {
       "flag": "ostler_thanked"
      }
     ]
    }
   }
  },
  "ostler_idle": {
   "nodes": {
    "start": {
     "text": "Easy now, easy. They're gone."
    }
   }
  },
  "hrodna": {
   "nodes": {
    "start": {
     "text": "You're the Concord lord. Good. I am Hrodna, of Clan Grimfell. I'll be short, because my people are cold.",
     "next": "b"
    },
    "b": {
     "text": "Our summer did not come. Your sky, your fire, whatever it is down there, ate it. Bjarr burns your granaries because he is angry. I am not angry. I am only hungry.",
     "next": "c"
    },
    "c": {
     "text": "Give my clan Coldwater's grain, and we go home over the pass tonight. Refuse, and Bjarr gets fifty more axes.",
     "choices": [
      {
       "text": "Take the grain. Go home, Hrodna.",
       "do": [
        {
         "flag": "hrodna_decided"
        },
        {
         "flag": "hrodna_fed"
        },
        {
         "leave": "clan",
         "to": [
          0.98,
          0.04
         ]
        },
        {
         "leave": "hrodna",
         "to": [
          0.98,
          0.04
         ]
        }
       ],
       "next": "fed"
      },
      {
       "text": "Coldwater will starve without it. I can't.",
       "do": [
        {
         "flag": "hrodna_decided"
        },
        {
         "flag": "hrodna_turned"
        },
        {
         "hostile": "clan"
        },
        {
         "hostile": "hrodna"
        },
        {
         "attack": "clan",
         "to": "hero"
        }
       ],
       "next": "turned"
      },
      {
       "text": "Half the grain. That's all I can give.",
       "if": {
        "hero_level": 18
       },
       "do": [
        {
         "flag": "hrodna_decided"
        },
        {
         "flag": "hrodna_fed"
        },
        {
         "flag": "grain_shared"
        },
        {
         "leave": "clan",
         "to": [
          0.98,
          0.04
         ]
        },
        {
         "leave": "hrodna",
         "to": [
          0.98,
          0.04
         ]
        }
       ],
       "next": "half"
      }
     ]
    },
    "fed": {
     "text": "Then the clans will remember one Concord lord who wasn't deaf. Kill Bjarr if you like. He won't be missed."
    },
    "half": {
     "text": "Half. ...Half gets us to spring, if the spring comes. You bargain like a northman, Wren. We go."
    },
    "turned": {
     "text": "Then you have chosen for my children. Grimfell! With Bjarr!"
    }
   }
  },
  "hrodna_after": {
   "nodes": {
    "start": {
     "text": "Keep your fires small, Concord. The sky has had enough."
    }
   }
  },
  "bjarr_parley": {
   "nodes": {
    "start": {
     "who": "bjarr",
     "text": "The Concord knight. Look up, knight. See the colour of it? That's your doing. Your fire under the mountain.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Burning my farmers won't turn the sky blue, Coldhand.",
     "next": "c"
    },
    "c": {
     "who": "bjarr",
     "text": "No. But it warms the hands. Axes!"
    }
   }
  }
 },
