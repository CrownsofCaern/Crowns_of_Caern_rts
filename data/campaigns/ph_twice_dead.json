 "dialogues": {
  "reeve": {
   "nodes": {
    "start": {
     "text": "Please. Please, lady. I'm only the reeve here. Hamlin Dace. My lord Wren is gone north and there's nobody left but farmers.",
     "next": "b"
    },
    "b": {
     "text": "Take what you came for and leave the Acre be. We've buried enough this year. Don't make us bury them twice.",
     "choices": [
      {
       "text": "Keep your village, reeve. I came for one dead man, not for yours.",
       "do": [
        {
         "flag": "reeve_decided"
        },
        {
         "flag": "acre_spared"
        },
        {
         "leave": "acre_folk",
         "to": [
          0.62,
          0.98
         ]
        }
       ],
       "next": "spare"
      },
      {
       "text": "Your churchyard is full of soldiers, reeve. I'll take them too.",
       "do": [
        {
         "flag": "reeve_decided"
        },
        {
         "flag": "acre_raised"
        },
        {
         "spawn": "acre_dead"
        },
        {
         "join": "acre_dead"
        },
        {
         "leave": "acre_folk",
         "to": [
          0.62,
          0.98
         ]
        }
       ],
       "next": "raise"
      }
     ]
    },
    "spare": {
     "text": "...Thank you. I'll tell my lord Wren that the Regent spared the Acre. He won't believe it."
    },
    "raise": {
     "text": "Gods. Gods forgive us. Come on, all of you, run!"
    }
   }
  },
  "reeve_after": {
   "nodes": {
    "start": {
     "text": "I've nothing more to give you, lady."
    }
   }
  },
  "raise": {
   "nodes": {
    "start": {
     "who": "hero",
     "text": "There you are. Under their banner, with your hands crossed. They washed you, Orrin. They were kind to you.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Up. You're not finished. Neither am I.",
     "do": [
      {
       "flag": "orrin_raised"
      },
      {
       "join": "body"
      }
     ],
     "next": "c"
    },
    "c": {
     "text": "...My lady. The chapel at the Rest. There was a young knight at the door. He had my face.",
     "next": "d"
    },
    "d": {
     "text": "Did the boy live?"
    }
   }
  },
  "aubert_parley": {
   "nodes": {
    "start": {
     "who": "aubert",
     "text": "The Regent herself. Sir Aldous said you'd come for the old knight. He said to burn him before you did.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Sir Aldous is a long way north. I'm here.",
     "next": "c"
    },
    "c": {
     "who": "aubert",
     "text": "Then I'll do it with you watching. Shields!"
    }
   }
  }
 },
