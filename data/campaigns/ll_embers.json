 "dialogues": {
  "skarn_parley": {
   "nodes": {
    "start": {
     "who": "skarn",
     "text": "A Wren. Again. The last one stood in that gate until the stone came down on him. Do you know what he said, at the end?",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Tell me.",
     "next": "c"
    },
    "c": {
     "who": "skarn",
     "text": "Nothing. He was too busy. Let's see if you are."
    }
   }
  },
  "gate": {
   "nodes": {
    "start": {
     "who": "hero",
     "text": "Here. This is where he stood.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Form on me! Shields to the front, bows behind, nobody runs! They come out of that hole, they die in this one!"
    }
   }
  }
 },
