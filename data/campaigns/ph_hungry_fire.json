 "dialogues": {
  "calloway": {
   "nodes": {
    "start": {
     "text": "Regent. Calloway, warden of the kings. Nineteen of them sleep in my tomb, with their knights around them. The Kindler wants them very badly.",
     "next": "b"
    },
    "b": {
     "text": "I can wake the knights. They'll fight for you, and gladly. But a tomb with its knights gone is just a cellar full of old men. If the fire comes, nothing will stop it.",
     "choices": [
      {
       "text": "Wake the knights. We need them in the field.",
       "do": [
        {
         "flag": "calloway_decided"
        },
        {
         "flag": "kings_woken"
        },
        {
         "spawn": "kings"
        }
       ],
       "next": "wake"
      },
      {
       "text": "Let them guard their kings. Send me what the tomb can spare instead.",
       "do": [
        {
         "flag": "calloway_decided"
        },
        {
         "res": {
          "gold": 300,
          "ore": 200
         }
        }
       ],
       "next": "keep"
      }
     ]
    },
    "wake": {
     "text": "Up, sworn ones. Your kings can watch over themselves for once."
    },
    "keep": {
     "text": "Grave-gold and old iron. The kings won't miss it. They never counted anything."
    }
   }
  },
  "calloway_after": {
   "nodes": {
    "start": {
     "text": "The kings sleep, Regent. For now."
    }
   }
  },
  "morvath_parley": {
   "nodes": {
    "start": {
     "who": "morvath",
     "text": "Little regent of rot. I was at the Sealing, did you know? I watched your fen-folk stand beside the living and shut us in. I remember every face.",
     "next": "b"
    },
    "b": {
     "who": "morvath",
     "text": "I've been burning them one by one. Yours will smell sweeter."
    }
   }
  }
 },
