 "dialogues": {
  "garran": {
   "nodes": {
    "start": {
     "text": "That's close enough, Regent. Garran of Fenwick. My levy holds this road for the Abbess. Not because I love her lamps.",
     "next": "b"
    },
    "b": {
     "text": "She burns every corpse in the march, ours too. My father went into her fire before he was cold. Fenwick has no graves left to visit.",
     "next": "c"
    },
    "c": {
     "text": "So. Tell me why I shouldn't fight you.",
     "choices": [
      {
       "text": "Because I spared Hobb's Acre, and I'll spare Fenwick. Stand aside.",
       "if": {
        "flag": "acre_spared"
       },
       "do": [
        {
         "flag": "garran_decided"
        },
        {
         "flag": "garran_aside"
        },
        {
         "leave": "fenwick_levy",
         "to": [
          0.5,
          0.02
         ]
        },
        {
         "leave": "garran",
         "to": [
          0.5,
          0.02
         ]
        }
       ],
       "next": "aside"
      },
      {
       "text": "Stand aside and Fenwick keeps its living. I want the Abbess, not you.",
       "do": [
        {
         "flag": "garran_decided"
        },
        {
         "flag": "garran_aside"
        },
        {
         "res": {
          "gold": -150
         }
        },
        {
         "leave": "fenwick_levy",
         "to": [
          0.5,
          0.02
         ]
        },
        {
         "leave": "garran",
         "to": [
          0.5,
          0.02
         ]
        }
       ],
       "next": "paid"
      },
      {
       "text": "You shouldn't. You should run.",
       "do": [
        {
         "flag": "garran_decided"
        },
        {
         "flag": "garran_fought"
        },
        {
         "hostile": "garran"
        },
        {
         "attack": "fenwick_levy",
         "to": "hero"
        }
       ],
       "next": "fight"
      }
     ]
    },
    "aside": {
     "text": "The Acre. Yes, the reeve told everyone. I didn't believe him. ...Fenwick stands aside. Don't make me sorry."
    },
    "paid": {
     "text": "Words are cheap from the dead. Pay my men for the road and we'll go home. ...Fine. Fenwick stands aside."
    },
    "fight": {
     "text": "Then Fenwick dies standing. Levy, form up!"
    }
   }
  },
  "garran_after": {
   "nodes": {
    "start": {
     "text": "I said I'd stand aside, Regent. I didn't say I'd watch."
    }
   }
  },
  "maud_parley": {
   "nodes": {
    "start": {
     "who": "maud",
     "text": "Corpse-queen. I have burned eleven thousand of your subjects. I will not stop at you.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Eleven thousand of your own people's grandparents, Abbess.",
     "next": "c"
    },
    "c": {
     "who": "maud",
     "text": "Grandparents rest. Yours walk. Light the lamps!"
    }
   }
  }
 },
