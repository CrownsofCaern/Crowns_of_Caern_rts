 "dialogues": {
  "corvin_join": {
   "nodes": {
    "start": {
     "who": "corvin",
     "text": "Regent. Corvin Mire. I kept a lamp in the fen villages for twenty years, until the lamp stopped answering. Then I kept something else.",
     "next": "b"
    },
    "b": {
     "who": "corvin",
     "text": "When my flock died of the fen-cough, the Concord buried them in a pit at Millbridge. No rites, no names, lime on top. I have a list. Millbridge is first on it.",
     "next": "c"
    },
    "c": {
     "who": "orrin",
     "text": "A lantern-priest who turned. I didn't think there were any left who could still surprise me.",
     "choices": [
      {
       "text": "Walk with me, Father. We'll start with your list.",
       "do": [
        {
         "flag": "corvin_joined"
        },
        {
         "flag": "corvin_list"
        },
        {
         "join": "corvin"
        },
        {
         "start_quest": "list"
        }
       ],
       "next": "list"
      },
      {
       "text": "Walk with me. Your list waits until the shore is mine.",
       "do": [
        {
         "flag": "corvin_joined"
        },
        {
         "join": "corvin"
        }
       ],
       "next": "wait"
      }
     ]
    },
    "list": {
     "who": "corvin",
     "text": "Thank you, Regent. They've waited long enough."
    },
    "wait": {
     "who": "corvin",
     "text": "As you say. They've waited this long."
    }
   }
  },
  "flock": {
   "nodes": {
    "start": {
     "who": "corvin",
     "text": "Here. Under the lime. Forty-one of them. I can hear them, Regent. They want to come up.",
     "next": "b"
    },
    "b": {
     "who": "orrin",
     "text": "Or they want to be left alone, Father. You don't know which. Neither does she.",
     "choices": [
      {
       "text": "Raise them, Corvin. Let them walk with the one who remembers their names.",
       "do": [
        {
         "flag": "flock_decided"
        },
        {
         "flag": "flock_raised"
        },
        {
         "spawn": "flock"
        },
        {
         "join": "flock"
        }
       ],
       "next": "raise"
      },
      {
       "text": "Give them their rites, here, and let them lie.",
       "do": [
        {
         "flag": "flock_decided"
        },
        {
         "flag": "flock_rested"
        },
        {
         "xp": 200
        }
       ],
       "next": "rest"
      }
     ]
    },
    "raise": {
     "who": "corvin",
     "text": "Up, children. Up. It's me. It's only me."
    },
    "rest": {
     "who": "corvin",
     "text": "...Rites, then. I still know the words. I didn't think I'd say them again."
    }
   }
  },
  "cantor": {
   "nodes": {
    "start": {
     "who": "cantor",
     "text": "Regent of Sallowmere. My choir has sung in this chapel since the fen drowned it. We do not kneel. We do not march. We sing.",
     "next": "b"
    },
    "b": {
     "who": "corvin",
     "text": "He'll let us through his chapel if you let him keep it, Regent. Or he won't let us through at all.",
     "choices": [
      {
       "text": "Keep your chapel, Cantor. We are only passing.",
       "do": [
        {
         "flag": "chapel_passed"
        },
        {
         "flag": "cantor_spared"
        },
        {
         "leave": "choir",
         "to": [
          0.66,
          0.98
         ]
        },
        {
         "leave": "cantor",
         "to": [
          0.66,
          0.98
         ]
        }
       ],
       "next": "pass"
      },
      {
       "text": "Everything under the fen kneels to me. Your choir too.",
       "do": [
        {
         "flag": "cantor_fight"
        },
        {
         "attack": "choir",
         "to": "hero"
        },
        {
         "attack": "cantor",
         "to": "hero"
        }
       ],
       "next": "fight"
      }
     ]
    },
    "pass": {
     "who": "cantor",
     "text": "Then pass, and be quiet in the nave."
    },
    "fight": {
     "who": "cantor",
     "text": "Sing, children. Sing her down."
    }
   }
  },
  "ilse_parley": {
   "nodes": {
    "start": {
     "who": "ilse",
     "text": "Shore levies, hold! That's no raider, that's their queen. Brother Tamsin said she'd come herself.",
     "next": "b"
    },
    "b": {
     "who": "ilse",
     "text": "Nobody passes the shore road, Regent. Nobody. Not while I've a single bow left."
    }
   }
  },
  "tamsin_parley": {
   "nodes": {
    "start": {
     "who": "tamsin",
     "text": "Corvin. I knew you, once. You kept the Millbridge lamp. You kept it well.",
     "next": "b"
    },
    "b": {
     "who": "corvin",
     "text": "And you buried my flock in lime, Tamsin.",
     "next": "c"
    },
    "c": {
     "who": "tamsin",
     "text": "I did. Lamps up! Burn them!"
    }
   }
  },
  "watcher": {
   "nodes": {
    "start": {
     "text": "..."
    }
   }
  }
 },
