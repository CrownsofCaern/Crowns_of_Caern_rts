 "dialogues": {
  "captain": {
   "nodes": {
    "start": {
     "text": "My lord Wren. Ysolde Marr, the Highmere riders. Six of us left out of thirty. We were at the ford when it came across.",
     "next": "b"
    },
    "b": {
     "text": "Give me leave and I'll ride for the levies myself and bring them faster. Or keep us here, and we'll hold the ford beside you.",
     "choices": [
      {
       "text": "Stay. I need every lance here.",
       "do": [
        {
         "flag": "captain_decided"
        },
        {
         "flag": "captain_stayed"
        },
        {
         "spawn": "captains_riders"
        },
        {
         "remove": "captain"
        }
       ],
       "next": "stay"
      },
      {
       "text": "Ride. Bring the levies before nightfall.",
       "do": [
        {
         "flag": "captain_decided"
        },
        {
         "flag": "captain_rode"
        },
        {
         "leave": "captain",
         "to": "greyhold"
        }
       ],
       "next": "ride"
      }
     ]
    },
    "stay": {
     "text": "Then we stay. Riders, dismount and form up. No, mount up. Gods, I don't know any more. Form on Sir Aldous!"
    },
    "ride": {
     "text": "Before nightfall, my lord. Hold till then."
    }
   }
  },
  "captain_after": {
   "nodes": {
    "start": {
     "text": "Hold, my lord."
    }
   }
  },
  "ferrier": {
   "nodes": {
    "start": {
     "text": "My lord, the smiths are asking: do we shoe horses, or melt every shoe and pot in Greyhold for arrowheads?",
     "choices": [
      {
       "text": "Arrowheads. Every pot.",
       "do": [
        {
         "flag": "ferrier_decided"
        },
        {
         "res": {
          "gold": 300,
          "ore": 150
         }
        }
       ],
       "next": "a"
      },
      {
       "text": "Horses. The riders will need to cross.",
       "do": [
        {
         "flag": "ferrier_decided"
        },
        {
         "res": {
          "gold": 150
         }
        },
        {
         "xp": 100
        }
       ],
       "next": "b"
      }
     ]
    },
    "a": {
     "text": "Every pot, my lord. My wife will kill me."
    },
    "b": {
     "text": "Horses it is. I'll have them shod by the morning."
    }
   }
  },
  "ferrier_after": {
   "nodes": {
    "start": {
     "text": "The forges haven't gone cold since dawn."
    }
   }
  },
  "ulk_parley": {
   "nodes": {
    "start": {
     "who": "vanguard_lord",
     "text": "Little sun-knight. You held the water. Good. The Host likes it when the meat fights.",
     "next": "b"
    },
    "b": {
     "who": "vanguard_lord",
     "text": "We were only the first spark. Burn."
    }
   }
  }
 },
