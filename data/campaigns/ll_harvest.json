    "b": {
     "who": "hero",
     "text": "Maelis. How many?",
     "next": "c"
    },
    "c": {
     "text": "Too many to be the summer's dead. And they're camped, my lord, with watch fires that don't give heat. I'll come with you. Somebody has to keep your back.",
     "do": [
      {
       "join": "maelis"
      }
     ]
    }
   }
  }
