 "dialogues": {
  "ossric": {
   "nodes": {
    "start": {
     "text": "Who walks in my hall with a crown she made herself? I am Ossric. I was king of the fen when your Sallowmere was a puddle.",
     "next": "b"
    },
    "b": {
     "text": "The stone is hot under my bed. Something scratches at the walls all night. My sleepers turn and turn and cannot rest. Tell me, little regent. Should I get up?",
     "choices": [
      {
       "text": "Get up, King Ossric. Your sleepers and mine will drive the diggers out together.",
       "do": [
        {
         "flag": "ossric_decided"
        },
        {
         "flag": "ossric_woken"
        },
        {
         "spawn": "sleepers"
        },
        {
         "join": "sleepers"
        },
        {
         "remove": "ossric"
        }
       ],
       "next": "woken"
      },
      {
       "text": "Sleep. I'll stop the scratching. You've earned your rest.",
       "do": [
        {
         "flag": "ossric_decided"
        },
        {
         "flag": "ossric_sleeps"
        },
        {
         "item": {
          "rarity": "rare",
          "slot": "helm",
          "level": 17
         }
        }
       ],
       "next": "sleep"
      }
     ]
    },
    "woken": {
     "text": "Then up, sleepers, up! It has been too long since we had anything to hate."
    },
    "sleep": {
     "text": "Rest. Yes. Take my crown, then; I won't need it under the stone. Wake me if you lose."
    }
   }
  },
  "ossric_after": {
   "nodes": {
    "start": {
     "text": "Mm. Still scratching."
    }
   }
  },
  "ambrel_ask": {
   "nodes": {
    "start": {
     "text": "Regent! Ambrel. I kept the grave-rolls of the Barrow Below. Every name, every king, on clay. The scarabs took the tablets for their nest. Clay is warm, you see.",
     "choices": [
      {
       "text": "I'll bring them back.",
       "do": [
        {
         "start_quest": "tablets"
        }
       ],
       "next": "yes"
      },
      {
       "text": "Clay can wait.",
       "next": "no"
      }
     ]
    },
    "yes": {
     "text": "Mind the stalker in there. It doesn't care that I'm dead."
    },
    "no": {
     "text": "Everything can wait, down here. Until it can't."
    }
   }
  },
  "ambrel_back": {
   "nodes": {
    "start": {
     "text": "My tablets! Look, look here. The newest roll. Fifty years ago the scratching started, under the eastern graves. The kings wrote it down and nobody upstairs read it.",
     "next": "b"
    },
    "b": {
     "text": "They've been digging for fifty years, Regent. Around something. Here, take this. It was on the scarabs' queen. I don't want it.",
     "do": [
      {
       "flag": "ambrel_done"
      },
      {
       "flag": "knows_burrows"
      }
     ]
    }
   }
  },
  "ambrel_idle": {
   "nodes": {
    "start": {
     "text": "Every name. Every king. Somebody has to keep them."
    }
   }
  },
  "garsh_parley": {
   "nodes": {
    "start": {
     "who": "garsh",
     "text": "Bones. Walking bones! We dig through you like roots through dirt, and now you walk up and bark at me?",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "You're digging through my country, Emberclaw. Why?",
     "next": "c"
    },
    "c": {
     "who": "garsh",
     "text": "Because the stone won't move, bone-queen. So we go round it. Burn her!"
    }
   }
  }
 },
