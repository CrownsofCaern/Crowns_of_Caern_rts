 "dialogues": {
  "hesk": {
   "nodes": {
    "start": {
     "text": "The Regent herself, at my door. Vathek's hill is ash, they say. Vathek was a fool. I am not.",
     "next": "b"
    },
    "b": {
     "text": "Morrow holds us together because he is the oldest, and because no one has ever beaten him. Old Tarn of Greywater is his right hand. Break Tarn and I will know you can break Morrow. Then I'll kneel.",
     "choices": [
      {
       "text": "Tarn first, then. Wait for me.",
       "do": [
        {
         "flag": "hesk_decided"
        },
        {
         "start_quest": "hesk"
        }
       ],
       "next": "wait"
      },
      {
       "text": "Kneel now, or burn with Morrow.",
       "do": [
        {
         "flag": "hesk_decided"
        },
        {
         "flag": "hesk_defied"
        },
        {
         "hostile": "hesk"
        },
        {
         "attack": "hesk_guard",
         "to": "hero"
        }
       ],
       "next": "defy"
      }
     ]
    },
    "wait": {
     "text": "I have waited three hundred years, Regent. I can wait for Tarn."
    },
    "defy": {
     "text": "Then come and light the fire yourself."
    }
   }
  },
  "hesk_kneel": {
   "nodes": {
    "start": {
     "text": "Tarn is dust. I felt him go. Well, Regent, I said I would.",
     "next": "b"
    },
    "b": {
     "text": "My howe kneels. My dead march with yours. And when you go down after whatever is burning under us, I want to be there.",
     "do": [
      {
       "flag": "hesk_knelt"
      },
      {
       "join": "hesk_guard"
      },
      {
       "leave": "hesk",
       "to": "hesk_howe"
      }
     ]
    }
   }
  },
  "hesk_wait": {
   "nodes": {
    "start": {
     "text": "Tarn first, Regent."
    }
   }
  },
  "wick": {
   "nodes": {
    "start": {
     "text": "Regent. Wick, bone-reeve of the court. We've more dead than we have bones to arm them. There's two ways to fix that.",
     "next": "b"
    },
    "b": {
     "text": "The old battlefield at Peatmoor is full of good iron and better bone. Or we sell the grave-goods from the court barrows to the river-traders. They pay in gold and they don't ask whose.",
     "choices": [
      {
       "text": "Dig up the battlefield.",
       "do": [
        {
         "flag": "wick_decided"
        },
        {
         "res": {
          "ore": 200,
          "wood": 100
         }
        }
       ],
       "next": "dig"
      },
      {
       "text": "Sell the grave-goods.",
       "do": [
        {
         "flag": "wick_decided"
        },
        {
         "flag": "grave_goods_sold"
        },
        {
         "res": {
          "gold": 350
         }
        }
       ],
       "next": "sell"
      }
     ]
    },
    "dig": {
     "text": "Iron and bone. The old soldiers won't mind; most of them are already in your ranks."
    },
    "sell": {
     "text": "Gold it is. Some of those rings belonged to people who are still walking about. I'll not tell them."
    }
   }
  },
  "wick_after": {
   "nodes": {
    "start": {
     "text": "Bones in the pits, Regent, and more coming every night."
    }
   }
  },
  "morrow_parley": {
   "nodes": {
    "start": {
     "who": "morrow",
     "text": "Little Ysmay. I remember when you were alive. You were a clever girl then, too.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Kneel, Morrow, and keep your Deep.",
     "next": "c"
    },
    "c": {
     "who": "morrow",
     "text": "I have slept here since before the Concord had a name. I will not be woken by a girl with a crown she made herself."
    }
   }
  }
 },
