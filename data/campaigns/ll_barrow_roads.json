 "dialogues": {
  "maelis_join": {
   "nodes": {
    "start": {
     "text": "My lord. I came back from the marsh as fast as I could. They march in columns, ten abreast, and they stop to let the slow ones catch up. Somebody is teaching them.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Then we teach them something else. Ride with me, Maelis.",
     "next": "c"
    },
    "c": {
     "text": "I'll take the bows. Mind the south road: there's a barrow every mile of it, and every one of them is open.",
     "do": [
      {
       "join": "maelis"
      },
      {
       "flag": "maelis_rides"
      }
     ]
    }
   }
  },
  "odo": {
   "nodes": {
    "start": {
     "text": "Don't look at me like that, my lord. A man has to eat. They pay in grave-silver, but silver's silver.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "You ferry the dead across your ford?",
     "next": "c"
    },
    "c": {
     "text": "Every night. A gentleman with a lantern pays the fare for all of them. Very polite. Never says a word.",
     "choices": [
      {
       "text": "Then the silver goes to Greyhold's war chest.",
       "do": [
        {
         "flag": "odo_decided"
        },
        {
         "flag": "odo_robbed"
        },
        {
         "res": {
          "gold": 300
         }
        }
       ],
       "next": "robbed"
      },
      {
       "text": "Sink your ferry. Here, for your trouble.",
       "if": {
        "marks": 40
       },
       "do": [
        {
         "flag": "odo_decided"
        },
        {
         "flag": "ford_closed"
        },
        {
         "marks": -40
        }
       ],
       "next": "sunk"
      },
      {
       "text": "You sold your neighbours to the dead. Hang him.",
       "do": [
        {
         "flag": "odo_decided"
        },
        {
         "flag": "odo_hanged"
        },
        {
         "remove": "odo"
        }
       ],
       "next": "hanged"
      }
     ]
    },
    "robbed": {
     "text": "All of it? That's... that's my whole winter, my lord. Fine. Take it. They'll come across anyway."
    },
    "sunk": {
     "text": "Sink her? She was my father's. ...Very well, my lord. No more dead cross at Fenwick. They'll have to go round by the south barrow."
    },
    "hanged": {
     "who": "hero",
     "text": "No one in Greyhold takes the dead's coin. Tell the village why."
    }
   }
  },
  "odo_after": {
   "nodes": {
    "start": {
     "text": "I'll keep to fish from now on, my lord."
    }
   }
  },
  "refugees": {
   "nodes": {
    "start": {
     "text": "My lord Wren? We're from the fen villages, south of the barrows. The dead came through at night and took the whole of Brackwater. Walked them away in rows.",
     "next": "b"
    },
    "b": {
     "text": "We've walked three days. Will Greyhold take us in? We can work. We can carry, dig, mind the fires.",
     "choices": [
      {
       "text": "Greyhold takes you in. Go north by the road.",
       "do": [
        {
         "flag": "refugees_decided"
        },
        {
         "flag": "refugees_taken"
        },
        {
         "remove": "refugees"
        },
        {
         "remove": "elder"
        },
        {
         "spawn": "new_hands"
        },
        {
         "spawn": "refugee_hunters"
        },
        {
         "say": "The dead are coming after the refugees! Cover the Waymeet road.",
         "who": "hero"
        }
       ]
      },
      {
       "text": "Greyhold has no bread to spare. Go west, over the hills.",
       "do": [
        {
         "flag": "refugees_decided"
        },
        {
         "flag": "refugees_turned"
        },
        {
         "leave": "refugees"
        },
        {
         "leave": "elder"
        }
       ]
      }
     ]
    }
   }
  },
  "refugees_after": {
   "nodes": {
    "start": {
     "text": "Gods keep you, my lord."
    }
   }
  },
  "grue_parley": {
   "nodes": {
    "start": {
     "who": "grue",
     "text": "My lord Wren. Mind the edges, they crumble. You've come to burn my neighbours a second time.",
     "next": "b"
    },
    "b": {
     "who": "grue",
     "text": "They were cold, my lord. Cold and forgotten under your fields. Now they walk, and they listen, and they never go hungry. Isn't that a kindness?",
     "choices": [
      {
       "text": "Who taught you this, Grue?",
       "next": "who"
      },
      {
       "text": "Lay down your lantern and I'll let you walk away again.",
       "if": {
        "flag": "grue_spared"
       },
       "next": "again"
      },
      {
       "text": "Enough talk.",
       "next": "end"
      }
     ]
    },
    "who": {
     "who": "grue",
     "text": "A priest, my lord. A lantern-priest from the fen, Father Corvin Mire. He says the ground is warm because something under it is waking. He says the dead are only the first to feel it.",
     "do": [
      {
       "flag": "learned_corvin"
      }
     ],
     "next": "end"
    },
    "again": {
     "who": "grue",
     "text": "You let me go once, and look what I made. No, my lord. Not twice.",
     "next": "end"
    },
    "end": {
     "who": "grue",
     "text": "Come down to the pits, then. My neighbours have been waiting for you."
    }
   }
  }
 },
