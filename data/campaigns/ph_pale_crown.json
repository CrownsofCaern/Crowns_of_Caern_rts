 "dialogues": {
  "wick": {
   "nodes": {
    "start": {
     "text": "Regent. They're saying crown, in the pits. A real one. It wants making, and I've two ways to make it.",
     "next": "b"
    },
    "b": {
     "text": "Melt the grave-gold of the old howes into a crown fit for a queen, and the treasury feels it. Or carve it from the bones of the first barrow-lords, and the dwellings get the gold instead.",
     "choices": [
      {
       "text": "Bone. The dead will crown me with their own.",
       "do": [
        {
         "flag": "wick_crown_decided"
        },
        {
         "flag": "bone_crown"
        },
        {
         "res": {
          "gold": 500,
          "ore": 300
         }
        }
       ],
       "next": "bone"
      },
      {
       "text": "Gold. Let the living see it glitter.",
       "do": [
        {
         "flag": "wick_crown_decided"
        },
        {
         "flag": "gold_crown"
        },
        {
         "res": {
          "wood": 300
         }
        },
        {
         "xp": 300
        }
       ],
       "next": "gold"
      }
     ]
    },
    "bone": {
     "text": "Bone it is. I know just the barrow-lords. They won't miss their jaws."
    },
    "gold": {
     "text": "Gold. It'll shine nicely under that red sky."
    }
   }
  },
  "wick_after": {
   "nodes": {
    "start": {
     "text": "The crown's coming along, Regent."
    }
   }
  },
  "skarn_parley": {
   "nodes": {
    "start": {
     "who": "skarn",
     "text": "The corpse-queen and her big dead bird. You've cost me a brood, a warren and a Kindler.",
     "next": "b"
    },
    "b": {
     "who": "hero",
     "text": "Get out of my country, Skarn. Go and burn the living. They're used to it.",
     "next": "c"
    },
    "c": {
     "who": "skarn",
     "text": "Oh, I will. But not before I take your Gate back."
    }
   }
  },
  "ithra_parley": {
   "nodes": {
    "start": {
     "who": "ithra",
     "text": "Regent. Skarn would sell me to you for a single tunnel. I would sell him for less.",
     "next": "b"
    },
    "b": {
     "who": "ithra",
     "text": "But I don't sell to the dead. Burn, bones."
    }
   }
  }
 },
